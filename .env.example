# ==============================================================================
# NexACS Environment Configuration (Copy to .env before running Docker Compose)
# ==============================================================================

# --- PostgreSQL ---
POSTGRES_DB=nexaacs
POSTGRES_USER=nexaacs
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# --- Cryptographic Keys (REQUIRED — generate each via: openssl rand -hex 32) ---
NEXAACS_JWT_SIGNING_KEY=REPLACE_WITH_64_HEX_CHAR_RANDOM_JWT_SECRET
NEXAACS_SECRET_MASTER_KEY=REPLACE_WITH_64_HEX_CHAR_RANDOM_AES256_MASTER_KEY

# --- TR-069 CWMP Connection Request Shared Fallback Credentials ---
NEXAACS_CWMP_SHARED_USERNAME=acs_cpe
NEXAACS_CWMP_SHARED_PASSWORD=CHANGE_ME_STRONG_CWMP_PASSWORD

# --- Network & Security ---
# Comma-separated browser origins allowed by CORS & WebSocket (e.g. https://acs.example.com,http://YOUR_SERVER_IP:8000)
NEXAACS_CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Optional public base URL sent to CPE modems for firmware downloads (e.g. http://YOUR_SERVER_IP:7567)
NEXAACS_FILE_PUBLIC_URL=

# --- Host Port Bindings ---
WEB_PORT=8000
CWMP_PORT=7547
FS_PORT=7567
API_BIND_IP=127.0.0.1
API_PORT=7557
TIMEZONE=Asia/Jakarta
