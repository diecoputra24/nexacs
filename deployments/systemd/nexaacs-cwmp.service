[Unit]
Description=NexaACS TR-069 CWMP Server
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=nexaacs
Group=nexaacs
WorkingDirectory=/opt/nexaacs/backend
EnvironmentFile=/etc/nexaacs/secrets.env
ExecStart=/opt/nexaacs/backend/bin/nexaacs-cwmp -config /etc/nexaacs/config.yaml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/nexaacs
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
