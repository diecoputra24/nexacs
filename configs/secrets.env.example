# Copy to /etc/nexaacs/secrets.env with chmod 600 owned by nexaacs:nexaacs
NEXAACS_DB_DSN=postgres://nexaacs:change_me_strong_password@127.0.0.1:5432/nexaacs?sslmode=disable
NEXAACS_REDIS_ADDR=127.0.0.1:6379
NEXAACS_REDIS_PASSWORD=
# 32-byte hex-encoded AES-256-GCM master key (generate via: openssl rand -hex 32)
NEXAACS_SECRET_MASTER_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
NEXAACS_JWT_SIGNING_KEY=replace_with_64_char_random_secret_for_api_tokens
NEXAACS_CWMP_SHARED_USERNAME=acs_cpe
NEXAACS_CWMP_SHARED_PASSWORD=replace_with_strong_cwmp_password
