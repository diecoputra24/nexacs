# Copy to /etc/nexaacs/secrets.env with chmod 600 owned by root:nexaacs
NEXAACS_DB_DSN=postgres://nexaacs:CHANGE_ME_STRONG_DB_PASSWORD@127.0.0.1:5432/nexaacs?sslmode=disable
NEXAACS_REDIS_ADDR=127.0.0.1:6379
NEXAACS_REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
# Generate 32-byte hex AES-256-GCM master key via: openssl rand -hex 32
NEXAACS_SECRET_MASTER_KEY=REPLACE_WITH_64_HEX_CHAR_SECRET_FROM_OPENSSL_RAND
# Generate 32-byte hex JWT signing secret via: openssl rand -hex 32
NEXAACS_JWT_SIGNING_KEY=REPLACE_WITH_64_HEX_CHAR_JWT_SECRET_FROM_OPENSSL_RAND
NEXAACS_CWMP_SHARED_USERNAME=acs_cpe
NEXAACS_CWMP_SHARED_PASSWORD=REPLACE_WITH_STRONG_CWMP_PASSWORD
# Comma-separated browser origins allowed by CORS & WebSocket (leave empty for same-origin behind Nginx)
NEXAACS_CORS_ALLOWED_ORIGINS=http://localhost:8000
# Optional public base URL CPEs use to download firmware (e.g. http://acs.example.com:7567)
NEXAACS_FILE_PUBLIC_URL=
